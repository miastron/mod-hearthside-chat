[worldserver]

########################################
# mod-hearthside-chat configuration
########################################
#
# Gives playerbots chat replies powered by a local AI (LLM) server. When a
# real player talks to a bot -- /say, whisper, or naming it by name -- at
# most 1-2 bots answer, never every bot in range at once. Settings below
# protect your AI server from being overloaded and control what happens if
# it goes down (bots just go quiet, they don't send broken replies).
#
# Bots also have three ways to "talk" that don't need a live AI call: quick
# canned reactions (gz, ty, lol...), fact-based answers looked up straight
# from game data (mount, level, zone...), and pre-written ambient chatter /
# bot-to-bot conversations that an idle-time background process writes
# ahead of time. All of this is configured below, section by section. Bot
# "personality" (talkativeness, typing sloppiness, etc.) is set up in the
# database instead of this file.

# --------------------------------------------
# CORE MODULE TOGGLES & DEBUGGING
# --------------------------------------------

# HearthsideChat.Enable
#     Description: Enable or disable the module.
#     Default:     1 (true)
HearthsideChat.Enable = 1

# HearthsideChat.DebugEnabled
#     Description: Enables extra logging for debugging purposes.
#     Default:     0 (false)
HearthsideChat.DebugEnabled = 0

# HearthsideChat.Bridge.Enable
#     Description: Lets the optional "HearthsideInspect" player addon ask the
#                  server for a bot's personality info (archetype, memory
#                  flavor, etc.) to show players in-game. Read-only -- it
#                  can't change anything. Works independently of
#                  HearthsideChat.Enable above; turn off if you don't want
#                  players able to see this info.
#     Default:     1 (true)
HearthsideChat.Bridge.Enable = 1

# --------------------------------------------
# LLM ENDPOINT
# --------------------------------------------

# HearthsideChat.LLM.ApiType
#     Description: Which API style your AI server speaks. "llamacpp" talks to
#                  llama.cpp's own API directly -- recommended, it's the
#                  fastest and lets replies reuse work from earlier requests.
#                  "openai" works with llama-server started using --jinja, or
#                  any other OpenAI-compatible AI server. "ollama" talks to
#                  Ollama.
#     Values:      llamacpp | openai | ollama
#     Default:     llamacpp
HearthsideChat.LLM.ApiType = llamacpp

# HearthsideChat.LLM.Template
#     Description: Only matters for ApiType=llamacpp. In that mode the
#                  module has to format the conversation itself in exactly
#                  the style the model was trained on -- pick the wrong one
#                  and replies come out garbled, or the model never stops
#                  talking. Check your model's page/README for which format
#                  it expects. Ignored for ApiType=openai/ollama, since those
#                  servers format the conversation themselves.
#     Values:      llama3 | chatml
#     Default:     llama3
HearthsideChat.LLM.Template = llama3

# HearthsideChat.LLM.Url
#     Description: Address of your AI server, with no path on the end -- the
#                  module adds that itself:
#                    llamacpp -> http://host:port
#                    openai   -> http://host:port/v1
#                    ollama   -> http://host:port
#                  If the AI server runs on another machine or in a
#                  container, only expose it through a firewall rule or a
#                  private network. Never make it reachable from the open
#                  internet.
#     Default:     http://127.0.0.1:8080
HearthsideChat.LLM.Url = http://127.0.0.1:8080

# HearthsideChat.LLM.Model
#     Description: Which model to use. Ignored for ApiType=llamacpp (that
#                  server only ever has one model loaded at a time); required
#                  for ApiType=openai/ollama.
#     Default:     (empty)
HearthsideChat.LLM.Model =

# HearthsideChat.LLM.ApiKey
#     Description: Password/token for the AI server, only needed if you
#                  started it with one set (llama-server's --api-key flag).
#                  Leave blank if your AI server doesn't require one.
#     Default:     (empty)
HearthsideChat.LLM.ApiKey =

# HearthsideChat.LLM.TimeoutSeconds
#     Description: HTTP timeout for one LLM call.
#     Default:     20
HearthsideChat.LLM.TimeoutSeconds = 20

# HearthsideChat.LLM.MaxTokens
#     Description: Upper limit on reply length (roughly, word-pieces). This
#                  is a safety ceiling, not a target -- the model normally
#                  stops well before it on its own. A reply that does hit the
#                  cap gets cut off mid-sentence, so raising this trades GPU
#                  time for rarely-needed extra length.
#     Default:     60
HearthsideChat.LLM.MaxTokens = 60

# HearthsideChat.LLM.SystemPrompt
#     Description: System-prompt half of the shared prompt prefix -- frames
#                  bots as ordinary players, not characters. A fixed
#                  few-shot example block completes the prefix and is
#                  hardcoded in hs_llm.cpp, not configurable here.
HearthsideChat.LLM.SystemPrompt = You are an ordinary player in World of Warcraft: Wrath of the Lich King, chatting in game. Reply the way a real player types in chat: casual, brief, one short line. No roleplay narration, no asterisks, no fantasy dialogue, no mention of being an AI or a game.

# HearthsideChat.LLM.HistoryTurns
#     Description: Trigger/reply pairs kept per bot-player pair and replayed
#                  as prior turns. 2 = four lines of history. Set to 0 to
#                  disable history entirely without a rebuild.
#     Default:     2
HearthsideChat.LLM.HistoryTurns = 2

# HearthsideChat.LLM.DryMultiplier
#     Description: Strength of a setting that discourages the model from
#                  repeating itself (llamacpp ApiType only; the setting is
#                  called "DRY" in llama.cpp). 0.0 turns it off. Testing on
#                  this module made replies *less* varied with it on, not
#                  more, so it ships off; enabling it also costs roughly
#                  85ms per reply.
#     Default:     0.0
HearthsideChat.LLM.DryMultiplier = 0.0

# --------------------------------------------
# REPLY GATING
# --------------------------------------------
# Player-initiated only. Candidate gating (real player, faction, range,
# combat) happens first; the arbiter then picks 0-2 of the eligible bots to
# answer -- /say, party/raid, guild, and the §4.17 channel surface all route
# through it (a named address always wins outright). Whisper is inherently
# 1:1, so it uses a simple chance roll instead of the arbiter. Live bot-to-bot
# chains (hs_botchain.h) also go through the same arbiter when they fire;
# scripted bot-to-bot replay is handled separately, via the corpus reserve
# below.

# HearthsideChat.Say.Distance
#     Description: Yards within which a bot is an eligible /say candidate.
#     Default:     30.0
HearthsideChat.Say.Distance = 30.0

# HearthsideChat.ReplyChance.Whisper
#     Description: Percent chance a bot answers a whisper directed at it.
#     Default:     100
HearthsideChat.ReplyChance.Whisper = 100

# HearthsideChat.ReplyCount.ZeroPercent / OnePercent / TwoPercent
#     Description: Once the arbiter has an eligible candidate pool (/say,
#                  party/raid, guild, channel, or a live bot-to-bot chain),
#                  these three weights decide how many bots answer: zero,
#                  one, or two (a named address always wins outright and
#                  ignores this roll). Relative weights, not cumulative
#                  percentages -- they need not add to 100, and there is no
#                  ordering requirement between them.
#     Default:     30 / 60 / 10
HearthsideChat.ReplyCount.ZeroPercent = 30
HearthsideChat.ReplyCount.OnePercent = 60
HearthsideChat.ReplyCount.TwoPercent = 10

# HearthsideChat.DisableRepliesInCombat
#     Description: Suppress replies while the sender or the candidate bot is in combat.
#     Default:     1 (true)
HearthsideChat.DisableRepliesInCombat = 1

# HearthsideChat.ExcludeNames
#     Description: Comma-separated bot character names this module never
#                  speaks through -- no reflex, grounded answer, corpus line,
#                  or LLM reply, and the bot is never archetype-assigned.
#                  Separate from mod-playerbots' own LevelBrackets.ExcludeNames/
#                  ResetBotLevel.ExcludeNames, which this module already
#                  manages automatically for carded bots -- those protect a
#                  bot FROM recycling; this one keeps a named bot out of
#                  Hearthside entirely, e.g. a bot reserved for another
#                  system or a GM's own test character.
#     Default:     (empty)
HearthsideChat.ExcludeNames =

# HearthsideChat.DebugChatLog.Enable
#     Description: Logs every reactive-tier (LLM) exchange -- trigger text,
#                  the model's pre-style output, and the styled text actually
#                  delivered -- to hside_chat_log, for an operator to review
#                  and hand-pick examples worth promoting. Does not write to
#                  hside_corpus by itself; promote entries manually via
#                  `.hearthside capture`. Not covered by any eviction sweep --
#                  prune it yourself on a busy realm.
#     Default:     0 (false)
HearthsideChat.DebugChatLog.Enable = 0

# --------------------------------------------
# RUNTIME QUEUE
# --------------------------------------------
# AI requests are sent to the server one at a time, never several at once --
# llama-server's parallel "slots" exist to keep recent conversations cached
# for speed, not to handle multiple requests simultaneously. The settings
# below are the real limits on how much load reaches your AI server: a
# per-minute request budget, a per-bot cooldown on top of it, and an
# automatic pause if the server stops responding.

# HearthsideChat.Queue.TTLSeconds
#     Description: A queued request older than this when the worker reaches
#                  it is dropped rather than answered -- silence beats a
#                  late reply.
#     Default:     15
HearthsideChat.Queue.TTLSeconds = 15

# HearthsideChat.Queue.MaxDepth
#     Description: Bounded queue depth. A request beyond this is dropped
#                  rather than queued.
#     Default:     20
HearthsideChat.Queue.MaxDepth = 20

# HearthsideChat.Bucket.RepliesPerMinute
#     Description: The main limit on AI usage -- how many AI replies are
#                  allowed per minute, total across every bot combined. The
#                  server can sustain about 104/min flat out; the default
#                  sits a little under that so this limit kicks in before
#                  the AI server itself starts queuing requests.
#     Default:     90
HearthsideChat.Bucket.RepliesPerMinute = 90

# HearthsideChat.Bucket.BurstCapacity
#     Description: How many replies can fire back-to-back in a short burst,
#                  above the steady per-minute rate above.
#     Default:     8
HearthsideChat.Bucket.BurstCapacity = 8

# HearthsideChat.Bot.CooldownSeconds
#     Description: Minimum seconds between two admitted requests for the
#                  same bot, regardless of bucket state.
#     Default:     8
HearthsideChat.Bot.CooldownSeconds = 8

# HearthsideChat.CircuitBreaker.FailureThreshold
#     Description: Consecutive LLM call failures before the breaker opens
#                  and further requests are silently rejected.
#     Default:     3
HearthsideChat.CircuitBreaker.FailureThreshold = 3

# HearthsideChat.CircuitBreaker.ProbeIntervalSeconds
#     Description: While the breaker is open, at most one request per this
#                  many seconds is let through as a probe. A successful
#                  probe closes the breaker.
#     Default:     15
HearthsideChat.CircuitBreaker.ProbeIntervalSeconds = 15

# --------------------------------------------
# TYPING DELAY
# --------------------------------------------
# Reflex/grounded/corpus-fallback replies already carry their own fixed
# 400-1500ms delay and are unaffected by this section. This is specifically
# the tier-2 (LLM) reply's delay: a same-tick reply is as unhuman as a
# four-minute one, so a base+per-character delay is applied on top of
# however long the LLM call itself already took -- never shortening what
# generation already cost, only topping it up toward a human-plausible total.

# HearthsideChat.TypingDelay.Enable
#     Description: Master toggle for the tier-2 typing delay.
#     Default:     1 (true)
HearthsideChat.TypingDelay.Enable = 1

# HearthsideChat.TypingDelay.MaxMs
#     Description: Cap on the total target delay (archetype's typing_base_ms
#                  + typing_per_char_ms*length, hside_archetype SQL), so a
#                  long reply can't stall delivery indefinitely. The formula
#                  itself is per-archetype, not an operator key -- this is
#                  only the ceiling, same relationship LLM.MaxTokens has
#                  with each archetype's verbosity cap.
#     Default:     6000
HearthsideChat.TypingDelay.MaxMs = 6000

# HearthsideChat.MinDeliveryDelayMs
#     Description: Unconditional floor on the tier-2 reply's total delay,
#                  applied even when TypingDelay.Enable is off -- without it,
#                  a fast backend could deliver a reply same-tick, which is
#                  as unhuman as a four-minute one. Reflex/grounded/corpus-
#                  fallback (400-1500ms) and scripted turns (800-2000ms+)
#                  already have their own floors and are unaffected.
#     Default:     400
HearthsideChat.MinDeliveryDelayMs = 400

# --------------------------------------------
# DISTRACTED REPLY -- the "sorry, was afk" flavor
# --------------------------------------------
# Occasionally a bot answers late and says so: it sends a short canned line
# ("sorry, was afk", "back", ...) after a delay, then the real reply a full
# typing delay after that. The odds are per-archetype
# (hside_archetype.distracted_chance), which replaced the old reply_chance
# column -- a personality that simply doesn't answer reads as being ignored,
# or as a broken module, on a realm that is almost entirely bots, so the same
# half-present trait is expressed as a late reply instead of a missing one.
#
# Note this is characterization, not backpressure: it is deliberately NOT
# driven by real backend latency or Queue.TTLSeconds. A TTL expiry means the
# request was dropped before inference ever ran, and on a GPU that is never
# stressed a latency-triggered version would simply never fire.
#
# The filler lines themselves are compiled in (hs_queue.cpp), like the tier-0
# reflex vocabulary -- editing them costs a rebuild.

# HearthsideChat.Distracted.Enable
#     Description: Master toggle. Off means no bot ever sends the filler
#                  line, whatever distracted_chance says.
#     Default:     1 (true)
HearthsideChat.Distracted.Enable = 1

# HearthsideChat.Distracted.MinDelaySeconds
#     Description: Floor on how long the bot appears to have been away before
#                  the "sorry, was afk" line lands. This is the setting that
#                  makes or breaks the illusion: apologizing for stepping
#                  away only five seconds ago is a transparent lie, so the
#                  floor has to be long enough to justify the apology.
#     Default:     25
HearthsideChat.Distracted.MinDelaySeconds = 25

# HearthsideChat.Distracted.MaxDelaySeconds
#     Description: Ceiling on that same gap -- long enough to be believable,
#                  short enough that the player doesn't conclude the bot is
#                  broken and walk away. Clamped up to MinDelaySeconds if set
#                  below it.
#     Default:     60
HearthsideChat.Distracted.MaxDelaySeconds = 60

# HearthsideChat.Distracted.CooldownSeconds
#     Description: Minimum seconds before the same bot can be "distracted"
#                  again, regardless of its archetype's chance. Without this,
#                  a player unlucky enough to be talking to a high-chance bot
#                  would experience it as one that constantly replies late.
#                  Keyed per bot, not per conversation.
#     Default:     600
HearthsideChat.Distracted.CooldownSeconds = 600

# --------------------------------------------
# TIER CEILINGS -- one AI-usage dial per kind of chat
# --------------------------------------------
# Every "MaxTier" key below caps how far that kind of chat is allowed to go:
#   off       - never speaks
#   reflex    - only quick canned reactions (gz, ty, lol, etc.)
#   corpus    - reflex, plus pre-written lines a background process authors
#               ahead of time -- no live AI call, no extra GPU cost
#   inference - all of the above, plus live AI-generated replies
# A bot falls back to the highest tier its ceiling allows rather than going
# silent -- "off" is the only value that silences a surface outright.
# All seven keys are live. DirectReply, EngagementFollowUp and Events request
# "inference" by default; BotToBot only does if you raise it from the
# "corpus" default (see the live-chains section further down).

# HearthsideChat.MaxTier.DirectReply
#     Description: Ceiling for replies directly addressed to a bot (/say,
#                  whisper, named mention).
#     Default:     inference
HearthsideChat.MaxTier.DirectReply = inference

# HearthsideChat.MaxTier.Ambient
#     Description: Ceiling for unprompted ambient chatter -- a bot speaking
#                  because there is dead air, not because anything happened.
#                  This is the only surface with no trigger at all; every
#                  other one needs an utterance, a game event, a shared
#                  context, or a prior reply.
#
#                  Corpus-only by design: "corpus" and "inference" behave
#                  identically, and "reflex" or "off" silence the surface.
#                  There is no generated ambient path and no plan for one --
#                  unprompted GPU spend against no question is the worst
#                  cost-per-value in the module, and the idle generator
#                  already writes this content offline for free.
#
#                  Speaks on /say, party, raid, and the Trade/General/World
#                  channels. See the Ambient.* keys below for volume, which
#                  is where the real tuning is -- and note this key is a
#                  ceiling, not the volume control: setting it to "off"
#                  silences ambient chatter but does NOT quiet openers or
#                  scripted scenes. Ambient.Bucket.RepliesPerMinute = 0 is
#                  the lever that quiets all three at once.
#     Default:     corpus
HearthsideChat.MaxTier.Ambient = corpus

# HearthsideChat.MaxTier.Openers
#     Description: Ceiling for shared-context-triggered openers (group
#                  formed, joint kill, rez, dungeon completed, prolonged
#                  proximity). "corpus" or "inference" both permit it (no
#                  higher tier is wired for this surface yet); "reflex" or
#                  "off" silence it.
#     Default:     corpus
HearthsideChat.MaxTier.Openers = corpus

# HearthsideChat.MaxTier.BotToBot
#     Description: Ceiling for bot-to-bot conversation. Two mechanisms sit
#                  under this one key, and because a ceiling is permissive
#                  rather than a mode switch, the higher value adds to the
#                  lower rather than replacing it:
#                    corpus    -- scripted replay only. Multi-turn scenes the
#                                 idle generator wrote earlier, replayed near
#                                 a player (/say) or cast into Trade/General/
#                                 World. No GPU cost at runtime.
#                    inference -- live chains as well: on party, raid and the
#                                 World channel, one bot's line becomes the
#                                 trigger another bot answers with a real
#                                 tier-2 call. Scripted replay still runs.
#                                 See the BotChain.* keys below, which are
#                                 inert at any other value.
#                  "reflex" or "off" silence both.
#
#                  Script pre-generation is NOT gated by this key -- the
#                  reserve is filled on Generator.Enable alone, so the GPU
#                  keeps writing scripts during idle at any setting here.
#     Default:     inference
HearthsideChat.MaxTier.BotToBot = inference

# HearthsideChat.MaxTier.Reflex
#     Description: Ceiling for tier-0 canned pattern replies: the plain
#                  gz/ty/inv/sum/lol/wb vocabulary, the "are you a bot?"
#                  question, and the personal-probe deflection set.
#                  Independent of MaxTier.DirectReply -- set to "off" to
#                  disable canned replies without touching the LLM ceiling.
#     Default:     reflex
HearthsideChat.MaxTier.Reflex = reflex

# HearthsideChat.MaxTier.EngagementFollowUp
#     Description: Ceiling for engagement follow-ups -- a bot continuing a
#                  conversation on its own initiative after it has already
#                  answered a player once. Generated via a second LLM call,
#                  not corpus -- only "inference" enables it; "corpus"
#                  behaves the same as "off" here (no canned-content path
#                  for this surface). Doubles GPU spend on every fired
#                  follow-up, so unlike Openers/BotToBot this defaults off
#                  rather than corpus -- opt in deliberately.
#     Default:     off
HearthsideChat.MaxTier.EngagementFollowUp = off

# HearthsideChat.MaxTier.Events
#     Description: Ceiling for event reactions -- a bot reacting to
#                  something that happened rather than to something someone
#                  said: its own or a groupmate's death, a wipe, a ding, a
#                  killing blow, winning or losing a group roll, and duels.
#                  Generated, not corpus: only "inference" enables it, and
#                  "corpus" behaves the same as "off" here, since a canned
#                  line about a specific death or drop would be wrong most
#                  of the time. Unlike EngagementFollowUp this defaults on --
#                  it only fires on something that actually happened, and
#                  Events.Bucket.* below is the real volume control.
#     Default:     inference
HearthsideChat.MaxTier.Events = inference

# HearthsideChat.Events.Bucket.RepliesPerMinute
#     Description: Token bucket for the event surface, entirely separate
#                  from Bucket.RepliesPerMinute above. One token is spent
#                  per *event*, before any candidate work and regardless of
#                  how many bots the event could have drawn -- and the
#                  arbiter that runs afterwards then stays silent for most
#                  events anyway (heavily so for deaths and duels), so
#                  actual spoken lines land well under this number.
#                  Separate because a busy dungeon generates deaths, loot
#                  and dings constantly, and sharing one budget would let
#                  ambient reactions starve replies to players who actually
#                  spoke. Set to 0 to turn the event surface off.
#     Default:     15
HearthsideChat.Events.Bucket.RepliesPerMinute = 15

# HearthsideChat.Events.Bucket.BurstCapacity
#     Description: Max event tokens bankable for a burst -- a wipe is the
#                  shape this exists for. Also a kill switch at 0.
#     Default:     4
HearthsideChat.Events.Bucket.BurstCapacity = 4

# --------------------------------------------
# UNPROMPTED SPEECH (AMBIENT, OPENERS, SCRIPTED SCENES)
# --------------------------------------------
# Read this section before tuning any of it, because the first key is not
# what it looks like.
#
# Three producers in this module speak without anyone having said anything:
#
#   - ambient chatter  -- a bot muses because there is dead air (MaxTier.Ambient)
#   - openers          -- a bot greets off a shared context (MaxTier.Openers)
#   - scripted scenes  -- two bots replay a written exchange (MaxTier.BotToBot)
#
# They share ONE budget: Ambient.Bucket.* below. It is named for ambient
# because ambient is the surface that forced the issue, but it governs all
# three.
#
# The reason they share it rather than each having their own: every other
# surface in this module is bounded by how often its trigger fires. Players
# only talk so much, mobs only die so often, so a per-surface cap there is a
# ceiling on something already self-limiting. These three are bounded only by
# the clock and the bot population -- and three producers each individually
# tuned to something reasonable still stack into constant noise, because
# nothing was ever measuring their sum. A realm's tolerance for bots talking
# among themselves is one quantity, so it gets one knob.
#
# Tune this UPWARD from live evidence, never downward. A too-quiet realm is
# recoverable; a too-noisy one has already spent the player's patience.
# Volume also scales with bot count, not player count, so a rate that felt
# right on a 200-bot test realm is not the same rate at 5000.

# HearthsideChat.Ambient.Bucket.RepliesPerMinute
#     Description: Shared token bucket for all three unprompted producers
#                  above. One token per line about to be spoken -- except a
#                  scripted scene, which spends one token for the whole
#                  multi-turn run rather than one per turn, since a scene is
#                  one thing a listener perceives.
#
#                  Deliberately below Events.Bucket.RepliesPerMinute (15):
#                  an event reaction at least fires on something that
#                  actually happened, and none of these three do. 6/min is
#                  roughly one unprompted line every ten seconds somewhere
#                  on the realm.
#
#                  Set to 0 to silence ambient chatter, openers and scripted
#                  scenes together -- this is the "quiet the realm" lever,
#                  not MaxTier.Ambient (which only covers the first of the
#                  three).
#     Default:     6
HearthsideChat.Ambient.Bucket.RepliesPerMinute = 6

# HearthsideChat.Ambient.Bucket.BurstCapacity
#     Description: Max unprompted tokens bankable, so a quiet stretch can be
#                  followed by a couple of lines close together rather than
#                  a metronome. Kept small on purpose: a burst of bots
#                  talking to themselves is exactly the thing that reads as
#                  a bot farm. Also a kill switch at 0.
#     Default:     2
HearthsideChat.Ambient.Bucket.BurstCapacity = 2

# HearthsideChat.Ambient.BotCooldownSeconds
#     Description: How long one bot waits after speaking ambiently before it
#                  may again. Independent of the shared bucket, which bounds
#                  the realm's total output rather than any one bot's -- both
#                  apply. At the default a given bot muses at most twice an
#                  hour, so the same character is never the one you keep
#                  hearing from.
#
#                  Applies to ambient chatter only. Openers keep their own
#                  per-(bot, player) cooldown, which asks a different
#                  question: an opener is addressed to someone, so what
#                  matters there is how recently this bot greeted THAT
#                  player.
#     Default:     1800
HearthsideChat.Ambient.BotCooldownSeconds = 1800

# HearthsideChat.Ambient.RequireRealPlayer
#     Description: Only speak where a real player can actually hear it -- in
#                  /say range, or a member of the same channel instance.
#                  Turning this off only makes sense when load-testing an
#                  empty realm.
#
#                  Party and raid ignore this key and always require a human
#                  in the group, because they get the guarantee for free:
#                  mod-playerbots' SayToParty/SayToRaid only send to real
#                  group members, so a bot-only group generates no packets at
#                  all. A line nobody receives would still spend a token from
#                  a realm-wide budget and still burn the speaker's cooldown,
#                  so it is never worth letting through.
#     Default:     1
HearthsideChat.Ambient.RequireRealPlayer = 1

# HearthsideChat.Ambient.Say.Enable
#     Description: Ambient chatter in /say, to whoever is standing nearby.
#                  Draws from the five chat_* corpus categories, the same
#                  pool the direct-reply corpus fallback uses.
#     Default:     1
HearthsideChat.Ambient.Say.Enable = 1

# HearthsideChat.Ambient.Party.Enable
#     Description: Ambient chatter in party chat -- between-pulls small talk
#                  and travel remarks addressed to the group, from the
#                  ambient_party_* corpus categories.
#     Default:     1
HearthsideChat.Ambient.Party.Enable = 1

# HearthsideChat.Ambient.Raid.Enable
#     Description: Ambient chatter in raid chat. Its own category
#                  (ambient_raid_downtime) rather than reusing the party
#                  one: a line that assumes it will be noticed reads wrong
#                  at twenty-five people.
#     Default:     1
HearthsideChat.Ambient.Raid.Enable = 1

# Trade, General and World ambient have no Enable key of their own -- they
# are gated by each channel's existing Channel.<name>.MaxTier and paced by
# that channel's own RatePerMin, on top of the shared bucket above. Set
# Channel.Trade.MaxTier = off to silence ambient there along with everything
# else this module says in Trade.
#
# Battleground ambient is deliberately not implemented. It would need a new
# delivery path (mod-playerbots has no SayToBG, and SayToRaid hardcodes
# CHAT_MSG_RAID, so a BG line would land in the wrong client tab), and a
# battleground is the one place where chat is overwhelmingly tactical --
# corpus-authored musing landing mid-fight would likely read worse than
# silence.

# --------------------------------------------
# LIVE BOT-TO-BOT CHAINS
# --------------------------------------------
# Inert unless MaxTier.BotToBot = inference (above). A chain runs on party,
# raid, or the World channel: a bot's delivered line is offered to the other
# bots sharing that group or channel, and one of them may answer it with a
# full tier-2 call. Whisper, guild and /say never chain -- /say already has
# the scripted proximity mechanism, and the other two have no bounded
# audience to pace a chain against.
#
# Every hop is a full LLM call, so these are the volume control on top of
# Bucket.RepliesPerMinute (which still caps everything) and, on World, that
# channel's own RatePerMin. A chain also ends the moment a real player speaks
# into the group or channel: the hop still generating is thrown away, and the
# bots' replies to that player start a new chain from what they actually
# said, so interrupting a conversation joins it rather than killing it.

# HearthsideChat.BotChain.MaxDepth
#     Description: Hard stop on how many hops one chain may run. A backstop,
#                  not the normal stop condition -- the decayed chance below
#                  ends most chains first. 0 disables chaining outright.
#     Default:     3
HearthsideChat.BotChain.MaxDepth = 3

# HearthsideChat.BotChain.BaseChancePercent
#     Description: Chance the first hop of a chain fires, per eligible line.
#     Default:     55
HearthsideChat.BotChain.BaseChancePercent = 55

# HearthsideChat.BotChain.DecayPercent
#     Description: Multiplier applied to the chance per additional hop, so
#                  hop N fires at Base * (Decay/100)^N. At the defaults that
#                  is 55% / 33% / 19%, averaging a bit over one extra hop per
#                  chain. Clamped to 99 -- at 100 the taper disappears and
#                  MaxDepth becomes the only thing ending a chain.
#     Default:     60
HearthsideChat.BotChain.DecayPercent = 60

# HearthsideChat.BotChain.ScopeCooldownSeconds
#     Description: How long a group or channel rests between chains. Checked
#                  only when starting a new chain, never between the hops of
#                  one already under way -- a conversation keeps its turns
#                  prompt, but the same party won't start a second
#                  conversation for this long.
#     Default:     180
HearthsideChat.BotChain.ScopeCooldownSeconds = 180

# HearthsideChat.BotChain.RequireRealPlayer
#     Description: Only chain where a real player can actually see it -- a
#                  human member in the group, or a human in the World
#                  channel. Bots talking to each other in an empty room is
#                  GPU spend against nobody's experience. Turn off only to
#                  load-test an empty realm.
#     Default:     1
HearthsideChat.BotChain.RequireRealPlayer = 1

# --------------------------------------------
# GLOBAL-CHANNEL CHAT SURFACE
# --------------------------------------------
# mod-playerbots joins every bot to every one of these seven channels
# unconditionally, with no config gate of its own. MaxTier reuses the same
# off/reflex/corpus/inference enum as above but is capped at "corpus" in
# practice -- speaking in a channel is corpus/script content only, never
# tier-2 inference. RatePerMin is a per-channel token bucket (not per-bot --
# a channel with most of the realm in it has no proximity bound to cap load
# otherwise). A token is spent per *triggering player message*, not per bot
# reply: the take happens before the candidate scan, so a throttled channel
# costs nothing, but the arbiter that runs afterwards decides no one answers
# roughly half the time. Actual chatter therefore lands near half this
# number -- RatePerMin = 6 is about 3 bot lines a minute, not 6.
# MaxCandidates caps how many eligible bots are even considered
# per triggering message (zone-local first, then a capped random sample) --
# without this cap, a busy channel would roll reply-chance against every
# member every message. LookingForGroup/GuildRecruitment/LocalDefense/
# WorldDefense default off (soliciting a group/guild the bot can't honour,
# or a system-shaped PvP alert, isn't something a bot conversationally
# chimes into) but are operator-adjustable like every other MaxTier key.

# HearthsideChat.Channel.Trade.MaxTier / .RatePerMin / .MaxCandidates
#     Description: Trade channel -- WTS/WTB flavor lines and live price
#                  commentary (bag stock only, never AH listings).
#     Default:     corpus / 3 / 8
HearthsideChat.Channel.Trade.MaxTier = corpus
HearthsideChat.Channel.Trade.RatePerMin = 3
HearthsideChat.Channel.Trade.MaxCandidates = 8

# HearthsideChat.Channel.General.MaxTier / .RatePerMin / .MaxCandidates
#     Description: General channel -- zone-flavor chatter.
#     Default:     corpus / 3 / 8
HearthsideChat.Channel.General.MaxTier = corpus
HearthsideChat.Channel.General.RatePerMin = 3
HearthsideChat.Channel.General.MaxCandidates = 8

# HearthsideChat.Channel.World.MaxTier / .RatePerMin / .MaxCandidates
#     NOTE:        World has no ChatChannels.dbc entry in WotLK and nothing
#                   auto-joins a real player to a channel literally named
#                   "World" -- bots were talking to each other in a channel no
#                   player could ever hear. World now delivers into General's
#                   real, zone-scoped channel and shares General's own
#                   MaxTier/RatePerMin/MaxCandidates and rate bucket
#                   (Hs_ChannelPolicyFor, hs_channel.cpp). These three keys are
#                   parsed but no longer independently read by anything --
#                   edit Channel.General.* instead. Kept only so an existing
#                   conf.dist line doesn't become an unknown key. World still
#                   contributes its own realm-wide-flavored corpus content
#                   (channel_world_chat) as a second content pool into that
#                   same channel.
#     Default:     corpus / 3 / 8
HearthsideChat.Channel.World.MaxTier = corpus
HearthsideChat.Channel.World.RatePerMin = 3
HearthsideChat.Channel.World.MaxCandidates = 8

# HearthsideChat.Channel.LookingForGroup.MaxTier / .RatePerMin / .MaxCandidates
#     Description: LookingForGroup channel. Off by default -- soliciting a
#                  group the bot can't honour is trap 14 in its purest form.
#     Default:     off / 0 / 0
HearthsideChat.Channel.LookingForGroup.MaxTier = off
HearthsideChat.Channel.LookingForGroup.RatePerMin = 0
HearthsideChat.Channel.LookingForGroup.MaxCandidates = 0

# HearthsideChat.Channel.GuildRecruitment.MaxTier / .RatePerMin / .MaxCandidates
#     Description: GuildRecruitment channel. Off by default, same reasoning
#                  as LookingForGroup.
#     Default:     off / 0 / 0
HearthsideChat.Channel.GuildRecruitment.MaxTier = off
HearthsideChat.Channel.GuildRecruitment.RatePerMin = 0
HearthsideChat.Channel.GuildRecruitment.MaxCandidates = 0

# HearthsideChat.Channel.LocalDefense.MaxTier / .RatePerMin / .MaxCandidates
#     Description: LocalDefense channel. Off by default -- system-shaped
#                  PvP alerts, nothing conversational belongs here.
#     Default:     off / 0 / 0
HearthsideChat.Channel.LocalDefense.MaxTier = off
HearthsideChat.Channel.LocalDefense.RatePerMin = 0
HearthsideChat.Channel.LocalDefense.MaxCandidates = 0

# HearthsideChat.Channel.WorldDefense.MaxTier / .RatePerMin / .MaxCandidates
#     Description: WorldDefense channel. Off by default, same reasoning as
#                  LocalDefense.
#     Default:     off / 0 / 0
HearthsideChat.Channel.WorldDefense.MaxTier = off
HearthsideChat.Channel.WorldDefense.RatePerMin = 0
HearthsideChat.Channel.WorldDefense.MaxCandidates = 0

# --------------------------------------------
# TIER-0 REFLEX
# --------------------------------------------
# The plain gz/ty/inv/sum/lol/wb vocabulary and the personal-probe
# deflection set are hardcoded content, not configurable here -- the
# pattern table is small, changes rarely, and editing it costs a rebuild
# deliberately, since it shouldn't be tuned casually.

# HearthsideChat.BotQuestion
#     Description: How a bot answers "are you a bot?" The illusion may
#                  break, but it must never be defended with a lie -- a
#                  flat "no, I'm a real player" is the one forbidden answer.
#                  "wink" is a non-answer ("maybe!", "huh?") that neither
#                  confirms nor denies. "deflect" is the more evasive subset
#                  ("huh?"/"what?" only). "silent" drops the question rather
#                  than answering it. "admit" is for operators who would
#                  rather their realm be straightforward about it.
#     Values:      wink | deflect | silent | admit
#     Default:     wink
HearthsideChat.BotQuestion = wink

# --------------------------------------------
# GROUNDED ANSWERS -- the fourth answer source
# --------------------------------------------
# Six questions the realm can already answer truthfully from live game
# state -- a bot's mount, level, zone, guild, profession skill, and what it
# is wearing -- answered by direct lookup and a short template rather than
# by asking the LLM to guess. No GPU work, no chance of invention. Not a
# tier ceiling; the question list and template wording are hardcoded
# content, same reasoning as the reflex table above.

# HearthsideChat.GroundedAnswers
#     Description: Master on/off switch for the grounded-answer branch.
#                  Independent of MaxTier.Reflex and MaxTier.DirectReply --
#                  an operator can disable this lookup path without
#                  touching either.
#     Values:      0 | 1
#     Default:     1
HearthsideChat.GroundedAnswers = 1

# HearthsideChat.GroundedAnswers.FuzzyMaxDistance
#     Description: After an exact-phrase match fails, how many single-
#                  character edits (Levenshtein distance) a player's message
#                  may differ from a listed phrase and still match -- typo
#                  tolerance only ("waht level are you" still hits Level),
#                  not a looser reword/substring match. A phrase whose
#                  length differs from the message by more than this many
#                  characters is skipped outright. If two different
#                  questions end up tied at the same distance, the match is
#                  treated as ambiguous and dropped (falls through) rather
#                  than guessed. 0 disables the fallback pass entirely
#                  (exact match only).
#     Values:      0+ (2-3 recommended; higher risks matching a genuinely
#                  different, oddly-worded sentence rather than a typo)
#     Default:     2
HearthsideChat.GroundedAnswers.FuzzyMaxDistance = 2

# --------------------------------------------
# IDLE-TIME GENERATOR
# --------------------------------------------
# Fills hside_corpus during GPU idle time -- picks one under-quota
# (category, tag-bucket) at a time, with quotas tracked per bucket rather
# than globally, generates one candidate line, and runs it through the same
# validation gate `.hearthside capture` uses (placeholder discipline, dedup,
# quality gate) before inserting. Only fires when the reactive tier has
# nothing queued and isn't mid-request -- generation is always the
# lowest-priority work.

# HearthsideChat.Generator.Enable
#     Description: Master on/off switch. Off by default: this is new,
#                  autonomous, GPU-spending, DB-writing background work, so
#                  an operator opts in rather than it starting the moment
#                  the module is enabled.
#     Default:     0 (false)
HearthsideChat.Generator.Enable = 0

# HearthsideChat.Generator.LLM.ApiType / Template / Url / Model / ApiKey / TimeoutSeconds / MaxTokens
#     Description: The generator's own LLM endpoint, kept separate from the
#                  reactive path's HearthsideChat.LLM.* -- whether or not
#                  they currently point at the same container. Same shape
#                  as the reactive keys above, including Template (see
#                  HearthsideChat.LLM.Template) -- meaningful independently
#                  since the generator can point at a differently-tuned
#                  model than the reactive endpoint.
#     Defaults:    llamacpp / llama3 / http://127.0.0.1:8080 / (empty) / (empty) / 30 / 60
HearthsideChat.Generator.LLM.ApiType = llamacpp
HearthsideChat.Generator.LLM.Template = llama3
HearthsideChat.Generator.LLM.Url = http://127.0.0.1:8080
HearthsideChat.Generator.LLM.Model =
HearthsideChat.Generator.LLM.ApiKey =
HearthsideChat.Generator.LLM.TimeoutSeconds = 30
HearthsideChat.Generator.LLM.MaxTokens = 60

# HearthsideChat.Generator.RowsPerBucket
#     Description: Target row count for each (category, tag-bucket) pair,
#                  tracked independently. The generator stops filling a
#                  bucket once it reaches this and moves on to whatever
#                  else is under quota.
#     Default:     20
HearthsideChat.Generator.RowsPerBucket = 20

# HearthsideChat.Generator.PollIntervalSeconds
#     Description: How often the generator rechecks whether the reactive
#                  tier has gone idle, while it's busy or the module/
#                  generator is disabled.
#     Default:     5
HearthsideChat.Generator.PollIntervalSeconds = 5

# HearthsideChat.Generator.QuotaSatisfiedBackoffSeconds
#     Description: How long the generator waits before checking again once
#                  every bucket it understands is at quota -- no sense
#                  polling every few seconds when there's nothing to do.
#     Default:     300
HearthsideChat.Generator.QuotaSatisfiedBackoffSeconds = 300

# HearthsideChat.Generator.PromptVersion
#     Description: Tags every row this generator run inserts (the
#                  hside_corpus.prompt_version column) so a bad run can be
#                  bulk-evicted later by this value alone. Bump it when the
#                  generation prompt changes meaningfully.
#     Default:     v1
HearthsideChat.Generator.PromptVersion = v2

# HearthsideChat.Generator.ScriptReserveTarget
#     Description: Target number of unconsumed scripted bot-to-bot
#                  conversations (hside_script) to keep in reserve. Takes
#                  priority over bucket-filling while under target, but
#                  behind the character-card work queue. If consumption
#                  outpaces production the bots simply stop chatting to
#                  each other -- running dry is the correct failure mode.
#     Default:     15
HearthsideChat.Generator.ScriptReserveTarget = 15

# --------------------------------------------
# OBSERVABILITY AND THE CONTROL API
# --------------------------------------------
# An optional web API for checking module status and (if you choose) making
# admin changes remotely, instead of typing GM commands in-game. Off by
# default. It uses one shared password for the whole server, not per-account
# logins -- this is a single-operator admin tool, not a multi-user site.
# Read-only requests (status/metrics/inspect) only need that password;
# requests that change anything (promote/demote/retire/pin/unpin/evict-run)
# additionally require HttpControlEnable below. The `.hearthside` in-game GM
# commands do everything this API can and work whether or not the API is
# turned on.
#
# RESTART REQUIRED for three of the five keys in this section. Every other
# HearthsideChat.* key in this file takes effect on `.reload config`, but
# HttpServerPort, HttpServerBind and HttpServerTimeoutSeconds are read once,
# at worldserver startup, when the listener is created and bound -- changing
# them and reloading appears to succeed and does nothing. HttpServerPrivateKey
# and HttpControlEnable DO reload, because they are read per request rather
# than at bind time.

# HearthsideChat.HttpServerPort
#     Description: Port to run the web API on. 0 turns it off entirely
#                  (default) -- the in-game GM commands cover the same
#                  actions without it.
#                  Read at worldserver startup only -- see the RESTART
#                  REQUIRED note above.
#     Default:     0
HearthsideChat.HttpServerPort = 0

# HearthsideChat.HttpServerBind
#     Description: Which network address to listen on. Loopback
#                  (127.0.0.1) means only this machine can reach it directly
#                  -- put a reverse proxy (nginx, etc.) in front if you want
#                  it reachable from elsewhere, rather than exposing it
#                  directly.
#                  Read at worldserver startup only -- see the RESTART
#                  REQUIRED note above.
#     Default:     127.0.0.1
HearthsideChat.HttpServerBind = 127.0.0.1

# HearthsideChat.HttpServerPrivateKey
#     Description: Shared password for the web API. Required whenever
#                  HttpServerPort above is non-zero -- if this is left
#                  blank, the server refuses to start rather than run
#                  unprotected.
#     Default:     (empty)
HearthsideChat.HttpServerPrivateKey =

# HearthsideChat.HttpServerTimeoutSeconds
#     Description: Read/write timeout for the HTTP server's connections.
#                  Read at worldserver startup only -- see the RESTART
#                  REQUIRED note above.
#     Default:     10
HearthsideChat.HttpServerTimeoutSeconds = 10

# HearthsideChat.HttpControlEnable
#     Description: A second switch that must also be on before the web API
#                  will accept change-making requests (promote/demote/
#                  retire/pin/unpin/evict-run) -- the password alone isn't
#                  enough. Read-only requests (status/metrics/inspect/
#                  review) don't need this, only the password. Off by
#                  default.
#     Default:     0 (false)
HearthsideChat.HttpControlEnable = 0
