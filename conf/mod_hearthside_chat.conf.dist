[worldserver]

########################################
# mod-hearthside-chat configuration
########################################
#
# Gives playerbots chat replies powered by a local AI (LLM) server. When a
# real player talks to a bot -- /say, whisper, or naming it by name -- at
# most 1-2 bots answer, never every bot in range at once. Settings below
# protect your AI server from being overloaded and control what happens if
# it goes down (bots just go quiet, they don't send broken replies).
#
# Bots also have three ways to "talk" that don't need a live AI call: quick
# canned reactions (gz, ty, lol...), fact-based answers looked up straight
# from game data (mount, level, zone...), and pre-written ambient chatter /
# bot-to-bot conversations that an idle-time background process writes
# ahead of time. All of this is configured below, section by section. Bot
# "personality" (talkativeness, typing sloppiness, etc.) is set up in the
# database instead of this file.

# --------------------------------------------
# LOGGING (set in worldserver.conf, not this file)
# --------------------------------------------
#
# This module logs to its own logger categories instead of the core's
# `server.loading` channel, so you can watch it closely without either
# drowning in, or hiding, normal server boot messages. Add any of these
# lines to worldserver.conf and give each its own level/appender:
#
#   module.hearthside            startup, config, table loads, bot identity
#                                changes, the HTTP control server
#   module.hearthside.llm        AI backend failures and recovery
#   module.hearthside.generator  the idle-time content generator
#   module.hearthside.chat       every chat request/reply (noisy -- mostly
#                                only shows up if HearthsideChat.DebugEnabled
#                                below is on)
#
# Logger names nest, so turning on `module` (or `root`) covers all four at
# once. Example -- show backend problems on the console, keep per-reply
# noise off:
#
#   Logger.module.hearthside.llm = 4,Console Server
#   Logger.module.hearthside.chat = 1,Server
#
# The first number is the level (1 = fatal errors only ... 5 = very
# detailed "trace" logging); the rest are appender names already defined
# in worldserver.conf.

# --------------------------------------------
# CORE MODULE TOGGLES & DEBUGGING
# --------------------------------------------

# HearthsideChat.Enable
#     Description: Turns the whole module on or off.
#     Default:     1 (true)
HearthsideChat.Enable = 1

# HearthsideChat.DebugEnabled
#     Description: Turns on extra, detailed logging for troubleshooting.
#                  Leave this off during normal play -- it's noisy.
#     Default:     0 (false)
HearthsideChat.DebugEnabled = 0

# HearthsideChat.Bridge.Enable
#     Description: Lets the optional "HearthsideInspect" player addon show
#                  players a bot's personality info (its archetype, memory
#                  flavor, etc.) in-game. Read-only -- the addon can't
#                  change anything through this. Works independently of
#                  HearthsideChat.Enable above, so turn this off separately
#                  if you don't want players able to see that info.
#     Default:     1 (true)
HearthsideChat.Bridge.Enable = 1

# --------------------------------------------
# LLM ENDPOINT
# --------------------------------------------

# HearthsideChat.LLM.ApiType
#     Description: Which API style your AI server speaks. "llamacpp" talks
#                  to llama.cpp directly -- recommended, it's the fastest
#                  and lets replies reuse work from earlier requests.
#                  "openai" works with llama-server started using --jinja,
#                  or any other OpenAI-compatible AI server. "ollama" talks
#                  to Ollama.
#     Values:      llamacpp | openai | ollama
#     Default:     llamacpp
HearthsideChat.LLM.ApiType = llamacpp

# HearthsideChat.LLM.Template
#     Description: Only matters when ApiType=llamacpp. In that mode this
#                  module has to format the conversation itself, in exactly
#                  the style the model was trained on ("chat template") --
#                  pick the wrong one and replies come out garbled, or the
#                  model never stops talking. Check your model's page for
#                  which format it expects. Ignored for ApiType=openai/
#                  ollama, since those servers format the conversation
#                  themselves.
#
#                  These are the same four names llama.cpp uses for its own
#                  --chat-template flag:
#                    llama3   Llama 3.x Instruct
#                    chatml   Qwen, and many others
#                    mistral  Mistral, Ministral
#                    gemma    Gemma 2/3
#
#                  An unrecognised value is refused with an error in the
#                  worldserver log and falls back to llama3, rather than
#                  being quietly misapplied and blamed on the model.
#     Values:      llama3 | chatml | mistral | gemma
#     Default:     llama3
HearthsideChat.LLM.Template = llama3

# HearthsideChat.LLM.Url
#     Description: Address of your AI server, with no path on the end -- the
#                  module adds that itself:
#                    llamacpp -> http://host:port
#                    openai   -> http://host:port/v1
#                    ollama   -> http://host:port
#                  If the AI server runs on another machine or in a
#                  container, only expose it through a firewall rule or a
#                  private network. Never make it reachable from the open
#                  internet.
#     Default:     http://127.0.0.1:8080
HearthsideChat.LLM.Url = http://127.0.0.1:8080

# HearthsideChat.LLM.Model
#     Description: Which model to use. Ignored for ApiType=llamacpp (that
#                  server only ever has one model loaded at a time);
#                  required for ApiType=openai/ollama.
#     Default:     (empty)
HearthsideChat.LLM.Model =

# HearthsideChat.LLM.ApiKey
#     Description: Password/token for the AI server, only needed if you
#                  started it with one set (llama-server's --api-key flag).
#                  Leave blank if your AI server doesn't require one.
#     Default:     (empty)
HearthsideChat.LLM.ApiKey =

# HearthsideChat.LLM.TimeoutSeconds
#     Description: How long to wait for the AI server to answer one request
#                  before giving up.
#     Default:     20
HearthsideChat.LLM.TimeoutSeconds = 20

# HearthsideChat.LLM.MaxTokens
#     Description: Upper limit on reply length (roughly, chunks of a word).
#                  This is a safety ceiling, not a target -- the model
#                  normally stops well before it on its own. A reply that
#                  does hit the cap gets cut off mid-sentence, so raising
#                  this trades AI-server time for rarely-needed extra length.
#     Default:     60
HearthsideChat.LLM.MaxTokens = 60

# HearthsideChat.LLM.SystemPrompt
#     Description: The instructions given to the AI before every reply,
#                  telling it to sound like an ordinary player rather than
#                  a character. A second, fixed example block is added
#                  automatically and isn't editable here (it lives in
#                  hs_llm.cpp).
HearthsideChat.LLM.SystemPrompt = You are a player in World of Warcraft, chatting in-game. Casual, brief, one short line. No roleplay, no asterisks, no mention of being an AI or a game. If you don't know something specific, deflect vaguely instead of making it up.

# HearthsideChat.LLM.HistoryTurns
#     Description: How many previous back-and-forths with the same player a
#                  bot remembers and includes in its next reply. 2 means the
#                  last two exchanges (four lines). Set to 0 to turn this
#                  off entirely.
#     Default:     2
HearthsideChat.LLM.HistoryTurns = 2

# HearthsideChat.LLM.DryMultiplier
#     Description: Strength of a setting (called "DRY" in llama.cpp) that
#                  discourages the AI from repeating itself. 0.0 turns it
#                  off. Testing on this module found it made replies less
#                  varied, not more, and it costs roughly 85ms extra per
#                  reply -- so it ships off. Only applies when ApiType is
#                  llamacpp.
#     Default:     0.0
HearthsideChat.LLM.DryMultiplier = 0.0

# --------------------------------------------
# REPLY GATING
# --------------------------------------------
# Only covers replies to something a player said. The module first filters
# out bots that clearly shouldn't answer (not a real player, wrong faction,
# too far away, in combat), then picks 0-2 of what's left to actually
# answer. This applies to /say, party/raid, guild chat, and the global
# channels further down (a bot addressed by name always answers). Whispers
# are one-on-one, so they use a simple chance roll instead of this
# candidate-and-pick process. Live bot-to-bot conversations (further down)
# go through the same picking process when they fire; pre-written bot-to-bot
# scenes are handled separately, in the corpus section.

# HearthsideChat.Say.Distance
#     Description: Yards within which a bot is close enough to answer a /say.
#     Default:     20.0
HearthsideChat.Say.Distance = 20.0

# HearthsideChat.ReplyChance.Whisper
#     Description: Percent chance a bot answers a whisper directed at it.
#     Default:     100
HearthsideChat.ReplyChance.Whisper = 100

# HearthsideChat.ReplyCount.ZeroPercent / OnePercent / TwoPercent
#     Description: Once there's a pool of eligible bots (for /say, party/
#                  raid, guild, channel chat, or an ongoing bot-to-bot
#                  conversation), these three numbers set the relative odds
#                  of zero, one, or two bots answering (a bot addressed by
#                  name always answers, ignoring this roll). They're
#                  relative weights, not percentages that have to add up to
#                  100.
#     Default:     30 / 60 / 10
HearthsideChat.ReplyCount.ZeroPercent = 30
HearthsideChat.ReplyCount.OnePercent = 60
HearthsideChat.ReplyCount.TwoPercent = 10

# HearthsideChat.DisableRepliesInCombat
#     Description: Suppress replies while the sender or the candidate bot is in combat.
#     Default:     1 (true)
HearthsideChat.DisableRepliesInCombat = 1

# HearthsideChat.ExcludeNames
#     Description: Comma-separated bot character names this module should
#                  never speak through at all -- no canned reactions, fact
#                  answers, pre-written lines, or AI replies, and the bot
#                  never gets a personality assigned. Use this for a bot
#                  reserved for something else, like a GM's own test
#                  character. Separate from mod-playerbots' own level-
#                  related exclude lists, which this module already manages
#                  automatically for its "known" bots -- those protect a bot
#                  FROM being recycled; this one keeps a named bot out of
#                  Hearthside entirely.
#     Default:     (empty)
HearthsideChat.ExcludeNames =

# HearthsideChat.DebugChatLog.Enable
#     Description: Logs every AI-generated exchange -- the trigger message,
#                  the AI's raw output, and the final styled reply -- to the
#                  hside_chat_log database table, so you can review them and
#                  hand-pick good ones to reuse later (via the
#                  `.hearthside capture` GM command). This log isn't cleaned
#                  up automatically -- prune it yourself on a busy realm.
#     Default:     0 (false)
HearthsideChat.DebugChatLog.Enable = 0

# --------------------------------------------
# RUNTIME QUEUE
# --------------------------------------------
# Requests to your AI server are sent one at a time, never several at once.
# The settings below are the real limits on how much load reaches your AI
# server: a per-minute request budget, a per-bot cooldown on top of it, and
# an automatic pause if the server stops responding.

# HearthsideChat.Queue.TTLSeconds
#     Description: A queued request that's been waiting longer than this
#                  gets dropped instead of answered late -- silence beats a
#                  stale reply.
#     Default:     15
HearthsideChat.Queue.TTLSeconds = 15

# HearthsideChat.Queue.MaxDepth
#     Description: Most requests allowed to be waiting at once. Anything
#                  beyond this is dropped instead of queued.
#     Default:     20
HearthsideChat.Queue.MaxDepth = 20

# HearthsideChat.Bucket.RepliesPerMinute
#     Description: The main limit on AI usage -- how many AI replies are
#                  allowed per minute, total across every bot combined.
#                  Lower this if your AI server can't keep up; the default
#                  already sits a bit under what a typical local server can
#                  sustain flat-out.
#     Default:     90
HearthsideChat.Bucket.RepliesPerMinute = 90

# HearthsideChat.Bucket.BurstCapacity
#     Description: How many replies can fire back-to-back in a short burst,
#                  above the steady per-minute rate above.
#     Default:     8
HearthsideChat.Bucket.BurstCapacity = 8

# HearthsideChat.Bot.CooldownSeconds
#     Description: Minimum seconds between two AI replies from the same
#                  bot, no matter what.
#     Default:     8
HearthsideChat.Bot.CooldownSeconds = 8

# HearthsideChat.CircuitBreaker.FailureThreshold
#     Description: Consecutive AI call failures before the module pauses
#                  and starts silently rejecting further requests, instead
#                  of letting bots keep failing to reply.
#     Default:     3
HearthsideChat.CircuitBreaker.FailureThreshold = 3

# HearthsideChat.CircuitBreaker.ProbeIntervalSeconds
#     Description: While paused, the module tries again at most once every
#                  this many seconds. A successful try turns replies back on.
#     Default:     15
HearthsideChat.CircuitBreaker.ProbeIntervalSeconds = 15

# --------------------------------------------
# TYPING DELAY
# --------------------------------------------
# This only affects AI-generated replies -- canned/fact-based/pre-written
# replies already have their own short fixed delay (400-1500ms) and aren't
# affected by this section. A reply that lands instantly looks as unnatural
# as one that takes four minutes, so the module adds a delay on top of
# however long the AI call itself already took, never shortening it.

# HearthsideChat.TypingDelay.Enable
#     Description: Master toggle for the extra typing delay on AI replies.
#     Default:     1 (true)
HearthsideChat.TypingDelay.Enable = 1

# HearthsideChat.TypingDelay.MaxMs
#     Description: Upper limit on the typing delay for an AI reply. The
#                  actual delay is based on the bot's personality (set in
#                  the database) and the reply's length; this setting is
#                  just the ceiling, so an unusually long reply can't stall
#                  delivery indefinitely.
#     Default:     6000
HearthsideChat.TypingDelay.MaxMs = 6000

# HearthsideChat.MinDeliveryDelayMs
#     Description: Minimum delay before any AI reply is delivered, even
#                  with TypingDelay.Enable off -- otherwise a fast AI server
#                  could deliver a reply the instant it's ready, which is
#                  just as unnatural as a long delay. Canned/fact-based/
#                  pre-written replies (400-1500ms) and scripted scenes
#                  (800-2000ms+) already have their own minimums and aren't
#                  affected by this.
#     Default:     400
HearthsideChat.MinDeliveryDelayMs = 400

# --------------------------------------------
# DISTRACTED REPLY -- the "sorry, was afk" flavor
# --------------------------------------------
# Occasionally a bot answers late and says so: a short canned line
# ("sorry, was afk", "back", ...) after a delay, then the real reply a full
# typing delay after that. How often this happens is set per bot
# personality in the database (hside_archetype.distracted_chance), not
# here -- it's meant to read as a personality quirk, not as the AI server
# being slow. It is deliberately NOT tied to actual backend slowness or to
# Queue.TTLSeconds: a request that times out was dropped before the AI ever
# saw it, and on a server that's never under real load, tying this to
# latency would mean it almost never fired.
#
# The filler lines themselves are hardcoded (in hs_queue.cpp), like the
# canned reflex vocabulary -- editing them needs a rebuild.

# HearthsideChat.Distracted.Enable
#     Description: Master toggle. Off means no bot ever sends the filler
#                  line, regardless of its personality's odds.
#     Default:     1 (true)
HearthsideChat.Distracted.Enable = 1

# HearthsideChat.Distracted.MinDelaySeconds
#     Description: Shortest gap before a "sorry, was afk" line can appear.
#                  Keep this reasonably long -- apologizing for stepping
#                  away five seconds ago doesn't ring true.
#     Default:     25
HearthsideChat.Distracted.MinDelaySeconds = 25

# HearthsideChat.Distracted.MaxDelaySeconds
#     Description: Longest such gap -- long enough to be believable, short
#                  enough that the player doesn't decide the bot is broken
#                  and move on. Clamped up to MinDelaySeconds if set below it.
#     Default:     60
HearthsideChat.Distracted.MaxDelaySeconds = 60

# HearthsideChat.Distracted.CooldownSeconds
#     Description: Minimum time before the same bot can be "distracted"
#                  again, regardless of its personality's odds -- otherwise
#                  a player talking to a high-odds bot would experience it
#                  as one that constantly replies late. Tracked per bot, not
#                  per conversation.
#     Default:     600
HearthsideChat.Distracted.CooldownSeconds = 600

# --------------------------------------------
# TIER CEILINGS -- one AI-usage dial per kind of chat
# --------------------------------------------
# Each "MaxTier" setting below caps how far that kind of chat is allowed to
# go:
#   off       - never speaks
#   reflex    - only quick canned reactions (gz, ty, lol, etc.)
#   corpus    - reflex, plus pre-written lines a background process writes
#               ahead of time -- no live AI call, no extra cost
#   inference - all of the above, plus live, AI-generated replies
# A bot falls back to the highest tier its setting allows rather than
# staying silent -- "off" is the only value that fully silences a surface.
# All seven settings below take effect immediately on `.reload config`, no
# restart needed. DirectReply, EngagementFollowUp and Events default to
# "inference"; BotToBot only reaches it if you raise it from its "corpus"
# default (see the live-chains section further down).

# HearthsideChat.MaxTier.DirectReply
#     Description: Ceiling for replies directly addressed to a bot (/say,
#                  whisper, named mention).
#     Default:     inference
HearthsideChat.MaxTier.DirectReply = inference

# HearthsideChat.MaxTier.Ambient
#     Description: Ceiling for unprompted chatter -- a bot talking because
#                  there's a lull, not because anything happened. "corpus"
#                  and "inference" behave the same here, since there's no
#                  live-AI ambient chatter, only pre-written lines;
#                  "reflex" or "off" turn it off entirely.
#
#                  This only controls whether ambient chatter can happen at
#                  all, not how much -- see the Ambient.* settings further
#                  down for volume. To quiet the realm, use
#                  HearthsideChat.Ambient.Bucket.RepliesPerMinute = 0, not
#                  this setting: that one also covers openers and scripted
#                  scenes, which this key doesn't touch.
#     Default:     corpus
HearthsideChat.MaxTier.Ambient = corpus

# HearthsideChat.MaxTier.Openers
#     Description: Ceiling for greetings triggered by a shared moment (a
#                  group forming, a joint kill, a rez, finishing a dungeon,
#                  or two bots lingering near each other). "corpus" or
#                  "inference" both allow it; "reflex" or "off" silence it.
#     Default:     corpus
HearthsideChat.MaxTier.Openers = corpus

# HearthsideChat.MaxTier.BotToBot
#     Description: Ceiling for bot-to-bot conversation. Two separate things
#                  live under this one setting, and raising it to
#                  "inference" adds the second on top of the first rather
#                  than replacing it:
#                    corpus    -- replays multi-turn scenes the background
#                                 generator wrote ahead of time, near a
#                                 player (/say) or in Trade/General. No AI
#                                 cost at the time it plays.
#                    inference -- also lets bots have live conversations: in
#                                 party, raid, and General chat, one bot's
#                                 line can trigger a real AI reply from
#                                 another bot (see the BotChain.* settings
#                                 further down, which do nothing at any
#                                 other value here). Scripted scenes still
#                                 run too.
#                  "reflex" or "off" turn off both.
#
#                  The background generator keeps writing scripted scenes
#                  regardless of this setting, as long as
#                  HearthsideChat.Generator.Enable is on -- this setting
#                  only controls whether they get used.
#     Default:     inference
HearthsideChat.MaxTier.BotToBot = inference

# HearthsideChat.MaxTier.Reflex
#     Description: Ceiling for the built-in canned reactions: the plain
#                  gz/ty/inv/sum/lol/wb vocabulary, the "are you a bot?"
#                  question, and deflecting personal questions.
#                  Independent of MaxTier.DirectReply -- set to "off" to
#                  disable canned replies without touching AI replies.
#     Default:     reflex
HearthsideChat.MaxTier.Reflex = reflex

# HearthsideChat.MaxTier.EngagementFollowUp
#     Description: Ceiling for a bot following up on its own, after it's
#                  already answered a player once. This always costs a
#                  second AI call, so unlike the other optional surfaces it
#                  defaults to off -- turn it on deliberately if you want
#                  it. Only "inference" enables it; "corpus" behaves the
#                  same as "off" here, since there's no pre-written version
#                  of a follow-up.
#     Default:     off
HearthsideChat.MaxTier.EngagementFollowUp = off

# HearthsideChat.MaxTier.Events
#     Description: Ceiling for bots reacting to something that happened
#                  rather than to something someone said: a death, a wipe,
#                  a ding, a killing blow, winning or losing a roll, a duel.
#                  Only "inference" enables it -- "corpus" behaves the same
#                  as "off" here, since a pre-written line about a specific
#                  death or drop would usually be wrong. On by default,
#                  since it only fires on something that actually happened;
#                  HearthsideChat.Events.Bucket.RepliesPerMinute below is
#                  the real volume control.
#     Default:     inference
HearthsideChat.MaxTier.Events = inference

# HearthsideChat.Events.Bucket.RepliesPerMinute
#     Description: Rate limit for event reactions, entirely separate from
#                  Bucket.RepliesPerMinute above. Kept separate because a
#                  busy dungeon generates deaths, loot and dings constantly,
#                  and sharing one budget would let those crowd out replies
#                  to players who actually spoke. One "token" is spent per
#                  event, not per bot reply, and most events don't end up
#                  producing a spoken line anyway -- so actual chatter stays
#                  well under this number. Set to 0 to turn off event
#                  reactions.
#     Default:     15
HearthsideChat.Events.Bucket.RepliesPerMinute = 15

# HearthsideChat.Events.Bucket.BurstCapacity
#     Description: How many event tokens can bank up for a burst -- a wipe
#                  is the classic case this covers. Also a kill switch at 0.
#     Default:     4
HearthsideChat.Events.Bucket.BurstCapacity = 4

# --------------------------------------------
# UNPROMPTED SPEECH (AMBIENT, OPENERS, SCRIPTED SCENES)
# --------------------------------------------
# Read this before tuning any of it -- the first setting below is not what
# it looks like.
#
# Three kinds of chat happen with no trigger from a player at all:
#
#   - ambient chatter  -- a bot musing because it's quiet (MaxTier.Ambient)
#   - openers          -- a greeting off a shared moment (MaxTier.Openers)
#   - scripted scenes  -- two bots replaying a written exchange
#                         (MaxTier.BotToBot)
#
# All three draw from ONE shared budget: Ambient.Bucket.* below. It's named
# for ambient chatter because that's the one that made a shared limit
# necessary, but it governs all three.
#
# They share a budget because none of them is naturally self-limiting the
# way a reply to a player is (players only talk so much, mobs only die so
# often). These three are bounded only by the clock and how many bots you
# run -- so even if each one looks reasonable on its own, their combined
# noise adds up unless something caps the total. A realm's tolerance for
# bots talking amongst themselves is one thing, so it gets one dial.
#
# Raise this from what you actually observe, rather than lowering it
# preemptively -- a too-quiet realm is easy to fix, a too-noisy one has
# already cost you the player's patience. This should also scale with how
# many bots you run, not how many players: a rate that felt right with 200
# bots is not the same rate at 5000.

# HearthsideChat.Ambient.Bucket.RepliesPerMinute
#     Description: Shared limit for all three unprompted producers above --
#                  one "token" per line about to be spoken, except a whole
#                  scripted scene only spends one token total (a listener
#                  perceives it as one thing, not several separate lines).
#
#                  Deliberately below Events.Bucket.RepliesPerMinute (15):
#                  an event reaction at least fires on something that
#                  actually happened, and none of these three do. 6/min is
#                  roughly one unprompted line every ten seconds somewhere
#                  on the realm.
#
#                  Set to 0 to silence ambient chatter, openers, and
#                  scripted scenes together -- this is the "quiet the
#                  realm" setting, not MaxTier.Ambient (which only covers
#                  the first of the three).
#     Default:     6
HearthsideChat.Ambient.Bucket.RepliesPerMinute = 6

# HearthsideChat.Ambient.Bucket.BurstCapacity
#     Description: How many unprompted tokens can bank up, so a quiet
#                  stretch can be followed by a couple of lines close
#                  together instead of a strict metronome. Kept small on
#                  purpose -- a burst of bots talking amongst themselves is
#                  exactly what reads as a bot farm. Also a kill switch at 0.
#     Default:     2
HearthsideChat.Ambient.Bucket.BurstCapacity = 2

# HearthsideChat.Ambient.BotCooldownSeconds
#     Description: How long one bot waits after speaking ambiently before
#                  it may again. Separate from (and on top of) the shared
#                  budget above -- that one limits the realm's total
#                  output, this one limits any single bot. At the default,
#                  one bot won't muse more than twice an hour, so the same
#                  character never becomes the one you keep hearing from.
#
#                  Only applies to ambient chatter. Openers have their own
#                  separate cooldown, tracked per bot-and-player pair
#                  instead: an opener is addressed to someone, so what
#                  matters there is how recently this bot greeted that
#                  specific player.
#     Default:     1800
HearthsideChat.Ambient.BotCooldownSeconds = 1800

# HearthsideChat.Ambient.RequireRealPlayer
#     Description: Only speak where an actual player could hear it -- in
#                  /say range, or in the same channel. Turn this off only
#                  to load-test an empty realm.
#
#                  Party and raid chat always require a real player anyway,
#                  for a different reason: mod-playerbots' own delivery for
#                  those only reaches real group members, so an all-bot
#                  group produces no chat traffic at all, and there'd be no
#                  point spending a token and a cooldown on a line nobody
#                  receives.
#     Default:     1
HearthsideChat.Ambient.RequireRealPlayer = 1

# HearthsideChat.Ambient.Say.Enable
#     Description: Ambient chatter in /say, to whoever is standing nearby.
#                  Draws from the same pool of pre-written lines used for
#                  the direct-reply fallback.
#     Default:     1
HearthsideChat.Ambient.Say.Enable = 1

# HearthsideChat.Ambient.Party.Enable
#     Description: Ambient chatter in party chat -- between-pulls small
#                  talk and travel remarks addressed to the group.
#     Default:     1
HearthsideChat.Ambient.Party.Enable = 1

# HearthsideChat.Ambient.Raid.Enable
#     Description: Ambient chatter in raid chat. Uses its own set of lines
#                  rather than the party ones -- a remark that assumes it
#                  will be noticed reads oddly to a 25-person raid.
#     Default:     1
HearthsideChat.Ambient.Raid.Enable = 1

# Trade and General ambient chatter have no Enable switch of their own here
# -- they're controlled by that channel's own Channel.<name>.MaxTier and
# RatePerMin settings further down, on top of the shared budget above. Set
# Channel.Trade.MaxTier = off to silence ambient chatter there along with
# everything else this module says in Trade.
#
# Battleground ambient chatter isn't implemented. There's no reliable way
# to deliver it to the right chat tab with the tools mod-playerbots
# exposes, and battlegrounds are the one place where chat is overwhelmingly
# tactical -- musing about the scenery mid-fight would likely read worse
# than staying quiet.

# --------------------------------------------
# UNPROMPTED /SAY -- SETTLED-STATE GATE AND FIRE CHANCES
# --------------------------------------------
# Three kinds of unprompted /say chat -- ambient musing, openers, and
# two-bot proximity scenes -- only fire when the bot is "settled": standing
# still AND either resting or milling about (not travelling, questing,
# fighting, or otherwise busy). This check itself isn't configurable --
# there's no realm where a bot chattering while sprinting to a quest
# objective is desirable. What IS configurable is the chance that follows
# it, because how much this filters out depends on what fraction of your
# bots happen to be resting or idle at any given moment, which varies by
# realm and can't be predicted by a default.
#
# This only applies to /say. Direct replies, party/raid/guild, and the
# global channels are unaffected -- a bot ignoring a player who spoke to it
# just because it's walking somewhere would be worse than the problem this
# prevents, and Trade/General are typed into from anywhere regardless of
# what the typist is doing. The one exception is the group-formed opener,
# delivered to party chat, which still fires from a bot on the move --
# not acknowledging a group invite reads as broken.
#
# The three chances below are starting points, not measurements -- tune
# them against what you actually see on a live realm. Setting any of them
# to 0 turns off that one producer's /say chatter without touching the
# others or the shared bucket above.

# HearthsideChat.Ambient.Say.FireChancePercent
#     Description: Chance an eligible ambient /say speaker actually speaks,
#                  once it's already settled, near a real player, AND near
#                  another bot -- that last part is what makes the line
#                  read as overheard rather than as the bot talking
#                  directly at the player and expecting an answer.
#     Default:     60
HearthsideChat.Ambient.Say.FireChancePercent = 60

# HearthsideChat.Openers.FireChancePercent
#     Description: Chance a bot delivers an opener once a shared moment has
#                  happened and its 10-minute per-pair cooldown has passed.
#                  Applies to every opener, including the party-chat
#                  group-formed one -- only the settled-state gate above is
#                  restricted to the /say triggers.
#     Default:     60
HearthsideChat.Openers.FireChancePercent = 60

# HearthsideChat.Script.Proximity.FireChancePercent
#     Description: Chance a scripted /say scene starts between two eligible
#                  bots standing near each other, checked every 30 seconds.
#                  Both bots need to be settled, not just one -- a scene
#                  runs several turns over minutes, and a bot that wanders
#                  off to a quest objective partway through leaves the
#                  other one talking to nobody.
#
#                  Doesn't affect the Trade/General channel scenes, which
#                  have no proximity or settled-state requirement and keep
#                  their own separate rate.
#     Default:     20
HearthsideChat.Script.Proximity.FireChancePercent = 20

# --------------------------------------------
# LIVE BOT-TO-BOT CHAINS
# --------------------------------------------
# Only matters if MaxTier.BotToBot above is set to "inference". A chain
# runs in party, raid, or the General channel: one bot's delivered line is
# offered to the other bots sharing that group or channel, and one of them
# may answer it with a real AI reply -- which can then be answered in turn,
# and so on. Whisper, guild and /say never chain this way -- /say already
# has the scripted-scene mechanism instead, and the other two have no
# bounded audience to pace a chain against.
#
# Every hop is a full AI call, so these settings are an extra layer of
# volume control on top of Bucket.RepliesPerMinute (which still caps
# everything) and, in General chat, that channel's own rate limit. A chain
# also ends the instant a real player speaks into the group or channel:
# whatever hop was still generating is thrown away, and the bots' next
# replies address that player instead -- so a player interrupting joins
# the conversation rather than cutting it off.

# HearthsideChat.BotChain.MaxDepth
#     Description: Hard stop on how many hops one chain may run. A
#                  backstop, not the normal way a chain ends -- the
#                  decaying chance below (DecayPercent) ends most chains
#                  first. 0 disables chaining outright.
#     Default:     3
HearthsideChat.BotChain.MaxDepth = 3

# HearthsideChat.BotChain.BaseChancePercent
#     Description: Chance the first reply in a chain happens at all, per
#                  eligible line.
#     Default:     55
HearthsideChat.BotChain.BaseChancePercent = 55

# HearthsideChat.BotChain.DecayPercent
#     Description: How much the chance drops with each additional hop in
#                  the chain -- at the defaults that's roughly 55%, then
#                  33%, then 19%, averaging a bit over one extra hop per
#                  chain. Clamped to 99: at 100 the chance would never
#                  drop, leaving MaxDepth as the only thing that ends a
#                  chain.
#     Default:     60
HearthsideChat.BotChain.DecayPercent = 60

# HearthsideChat.BotChain.ScopeCooldownSeconds
#     Description: How long a group or channel rests between chains.
#                  Checked only when starting a new chain, never between
#                  the hops of one already under way -- a conversation
#                  keeps its own pace, but the same party won't start a
#                  second one for this long.
#     Default:     180
HearthsideChat.BotChain.ScopeCooldownSeconds = 180

# HearthsideChat.BotChain.RequireRealPlayer
#     Description: Only chain where a real player can actually see it -- a
#                  human in the group, or a human in the General channel.
#                  Bots talking to each other in an empty room spends AI
#                  time on nobody's experience. Turn off only to load-test
#                  an empty realm.
#     Default:     1
HearthsideChat.BotChain.RequireRealPlayer = 1

# --------------------------------------------
# GLOBAL-CHANNEL CHAT SURFACE
# --------------------------------------------
# mod-playerbots puts every bot into all six of these channels
# automatically, with no gate of its own -- there's no way to opt a bot out
# of a channel here, only to control whether and how much this module
# makes bots speak in it. In practice, these channels only ever get
# canned/pre-written content: MaxTier reuses the same off/reflex/corpus/
# inference scale as the tier ceilings above, but a live AI reply never
# happens here even at "inference".
#
# RatePerMin limits the whole channel, not each bot individually (a channel
# with most of the realm in it has no natural size limit otherwise). Around
# one "token" is spent per player message that could trigger a reply, and
# roughly half of those end up with no bot answering anyway -- so actual
# chatter lands near half this number (RatePerMin = 6 is about 3 bot lines
# a minute, not 6). MaxCandidates limits how many bots are even considered
# per triggering message, so a busy channel doesn't have to check every
# member on every message.
#
# LookingForGroup, GuildRecruitment, LocalDefense and WorldDefense default
# to off -- soliciting a group/guild a bot can't actually honour, or
# chiming into a system-generated PvP alert, isn't something a bot should
# do conversationally -- but you can turn any of them on like any other
# setting here.

# HearthsideChat.Channel.Trade.MaxTier / .RatePerMin / .MaxCandidates
#     Description: Trade channel -- WTS/WTB-style flavor lines and comments
#                  on the bot's own bag stock (never actual auction house
#                  listings).
#     Default:     corpus / 3 / 8
HearthsideChat.Channel.Trade.MaxTier = corpus
HearthsideChat.Channel.Trade.RatePerMin = 3
HearthsideChat.Channel.Trade.MaxCandidates = 8

# HearthsideChat.Channel.General.MaxTier / .RatePerMin / .MaxCandidates
#     Description: General channel -- casual zone chatter. Resolved per
#                  zone, so a bot's audience is only the other players
#                  standing in the same zone.
#
#                  RatePerMin dropped 3 -> 1 on 2026-09-13 (operator read
#                  from the live realm): 3/min is 180 lines an hour into a
#                  channel a player sits in all session, which reads as a
#                  busier General than a real one. Real General chat is
#                  bursty and mostly quiet, and the module has no burst
#                  shape to spend a higher rate on -- so the honest setting
#                  is the low steady one.
#     Default:     corpus / 1 / 8
HearthsideChat.Channel.General.MaxTier = corpus
HearthsideChat.Channel.General.RatePerMin = 1
HearthsideChat.Channel.General.MaxCandidates = 8

# HearthsideChat.Channel.LookingForGroup.MaxTier / .RatePerMin / .MaxCandidates
#     Description: LookingForGroup channel. Off by default -- see the note
#                  above.
#     Default:     off / 0 / 0
HearthsideChat.Channel.LookingForGroup.MaxTier = off
HearthsideChat.Channel.LookingForGroup.RatePerMin = 0
HearthsideChat.Channel.LookingForGroup.MaxCandidates = 0

# HearthsideChat.Channel.GuildRecruitment.MaxTier / .RatePerMin / .MaxCandidates
#     Description: GuildRecruitment channel. Off by default, same
#                  reasoning as LookingForGroup.
#     Default:     off / 0 / 0
HearthsideChat.Channel.GuildRecruitment.MaxTier = off
HearthsideChat.Channel.GuildRecruitment.RatePerMin = 0
HearthsideChat.Channel.GuildRecruitment.MaxCandidates = 0

# HearthsideChat.Channel.LocalDefense.MaxTier / .RatePerMin / .MaxCandidates
#     Description: LocalDefense channel. Off by default -- this channel
#                  carries system PvP alerts, not conversation.
#     Default:     off / 0 / 0
HearthsideChat.Channel.LocalDefense.MaxTier = off
HearthsideChat.Channel.LocalDefense.RatePerMin = 0
HearthsideChat.Channel.LocalDefense.MaxCandidates = 0

# HearthsideChat.Channel.WorldDefense.MaxTier / .RatePerMin / .MaxCandidates
#     Description: WorldDefense channel. Off by default, same reasoning as
#                  LocalDefense.
#     Default:     off / 0 / 0
HearthsideChat.Channel.WorldDefense.MaxTier = off
HearthsideChat.Channel.WorldDefense.RatePerMin = 0
HearthsideChat.Channel.WorldDefense.MaxCandidates = 0

# --------------------------------------------
# TIER-0 REFLEX
# --------------------------------------------
# The plain gz/ty/inv/sum/lol/wb vocabulary and the personal-question
# deflection set are hardcoded content, not configurable here -- the list
# is small, changes rarely, and editing it needs a rebuild deliberately,
# since it shouldn't be tuned casually.

# HearthsideChat.BotQuestion
#     Description: How a bot answers "are you a bot?" It's fine for the
#                  illusion to break, but it must never be defended with a
#                  lie -- a flat "no, I'm a real player" isn't one of the
#                  choices.
#                    wink    - a non-answer ("maybe!", "huh?") that neither
#                              confirms nor denies
#                    deflect - a more evasive version ("huh?"/"what?" only)
#                    silent  - drops the question instead of answering it
#                    admit   - says yes, honestly -- for operators who'd
#                              rather their realm be upfront about it
#     Values:      wink | deflect | silent | admit
#     Default:     wink
HearthsideChat.BotQuestion = wink

# --------------------------------------------
# GROUNDED ANSWERS -- the fourth answer source
# --------------------------------------------
# Six questions the realm can already answer truthfully from a bot's actual
# character data -- its mount, level, zone, guild, profession skill, and
# what it's wearing -- answered by a direct lookup and a short template
# rather than by asking the AI to guess. No AI cost, and no chance of it
# making something up. Not a tier ceiling; the question list and reply
# wording are hardcoded, same reasoning as the reflex section above.

# HearthsideChat.GroundedAnswers
#     Description: Master on/off switch for this lookup feature.
#                  Independent of MaxTier.Reflex and MaxTier.DirectReply --
#                  you can turn this off without touching either of those.
#     Values:      0 | 1
#     Default:     1
HearthsideChat.GroundedAnswers = 1

# HearthsideChat.GroundedAnswers.FuzzyMaxDistance
#     Description: How many typos a player's message can have and still
#                  match one of the recognized questions. This counts
#                  single-character edits (a "Levenshtein distance"), so
#                  "waht level are you" still matches "what level are you"
#                  as a typo -- it is typo tolerance only, not a general
#                  reword or substring match. A phrase whose length differs
#                  too much from the message is skipped outright, and if
#                  two different questions end up equally close, the match
#                  is treated as too ambiguous and dropped rather than
#                  guessed. 0 turns this off entirely (exact match only).
#     Values:      0+ (2-3 recommended; higher risks matching a genuinely
#                  different, oddly-worded sentence instead of a typo)
#     Default:     2
HearthsideChat.GroundedAnswers.FuzzyMaxDistance = 2

# --------------------------------------------
# WORLD-KNOWLEDGE RETRIEVAL (RAG)
# --------------------------------------------
# Gives bots real, authored World of Warcraft knowledge to draw on, instead
# of letting the AI invent an answer when a player asks something like
# "where do I train blacksmithing." (In AI terminology this technique is
# called "RAG" -- retrieval-augmented generation -- which is where the
# setting names below come from.) None of this module's other answer
# sources know general game lore: GroundedAnswers above only knows a bot's
# own live stats, and memory only knows a specific player.
#
# When what a player said is close enough to one of the authored reference
# paragraphs, that paragraph gets appended to the AI's prompt before it
# writes a reply. The paragraphs live in the hside_rag database table,
# which is GENERATED from data/rag/*.json by data/rag/generate_rag_sql.py --
# to change what bots know, edit the JSON, regenerate, re-apply the SQL,
# and run `.reload config`. See data/rag/README.md for the authoring rules.
#
# This is not a tier ceiling: it never decides whether a bot speaks, only
# what's in the prompt when one already is. Every surface that reaches the
# AI gets this, still bounded by that surface's own MaxTier ceiling.

# HearthsideChat.Rag.Enable
#     Description: Turns retrieval on for live AI replies -- direct
#                  replies, event reactions, engagement follow-ups, and
#                  bot-to-bot chain hops. Off restores the old behavior:
#                  those prompts get no reference material at all.
#     Default:     1
HearthsideChat.Rag.Enable = 1

# HearthsideChat.Rag.MaxEntries
#     Description: Most reference paragraphs added to one prompt. Kept low
#                  on purpose -- a second match is usually a weaker one,
#                  and beyond two the block starts reading like a briefing
#                  document rather than something a player just happens to
#                  know.
#     Default:     2
HearthsideChat.Rag.MaxEntries = 2

# HearthsideChat.Rag.MinScore
#     Description: How confident a match has to be before it's used at
#                  all. This is the setting that matters most here, and the
#                  risk isn't symmetric: raising it only means fewer
#                  questions get reference material, which is safe.
#                  Lowering it risks handing a bot a paragraph about
#                  something nobody actually asked about, which derails a
#                  reply that would otherwise have been fine -- a wrong
#                  reference is worse than none. See data/rag/README.md
#                  before changing this if you're also adding new
#                  reference material, since the two interact.
#     Default:     0.45
HearthsideChat.Rag.MinScore = 0.45

# HearthsideChat.Rag.MaxChars
#     Description: Character limit for the whole block of reference text
#                  added to one prompt. This is extra reading the AI has to
#                  do before it starts writing a reply, so it's a direct
#                  latency cost on live replies.
#     Default:     700
HearthsideChat.Rag.MaxChars = 700

# HearthsideChat.Rag.Generator.Enable
#     Description: Turns retrieval on for the idle-time background
#                  generator (see IDLE-TIME GENERATOR below) instead of
#                  live replies. Kept as a separate switch from Rag.Enable
#                  because a bad match here is much lower-risk: generated
#                  lines pass through a quality check and can be reviewed
#                  (`.hearthside review`) and discarded before any player
#                  ever sees them, while a bad match on a live reply is
#                  already in the chat window the moment it happens.
#                  Turning this off doesn't make generated lines vaguer --
#                  it removes their only source of real game facts, which
#                  is what caused made-up game vocabulary in generated
#                  lines before this existed. If you want to try retrieval,
#                  turn this on before Rag.Enable.
#     Default:     1
HearthsideChat.Rag.Generator.Enable = 1

# HearthsideChat.Rag.Generator.MaxChars
#     Description: The same character budget as Rag.MaxChars, but for
#                  generation prompts. Set higher on purpose: generation
#                  runs offline, so a longer prompt costs idle AI-server
#                  time rather than a player's wait, and its output is
#                  reviewable before use.
#     Default:     900
HearthsideChat.Rag.Generator.MaxChars = 900


# --------------------------------------------
# AMBIENT EXPERIENCE
# --------------------------------------------
# Gives bots a memory of what they've been doing lately -- quests, loot,
# money, zone changes, professions, level-ups, deaths -- added as
# background to their next reply so they can sound like they've actually
# been playing, not just standing around waiting to chat.
#
# This is not a tier and it never makes a bot speak by itself. A bot
# reacting to something that just happened is the separate MaxTier.Events
# feature above; this only changes what a bot mentions when it's already
# talking for some other reason.
#
# Nothing here is saved to the database. A worldserver restart clears it
# all, which is intentional -- "what I've been up to lately" shouldn't
# outlive a restart the way a bot's relationship memory (hside_memory)
# does.
#
# Repeated events collapse into a count instead of piling up, so four
# deaths in one zone become a single "died in Sholazar Basin (4 times)"
# rather than four separate entries. That's what keeps the noisier hooks
# (loot, money, skill gains) from flooding a bot's memory.

# HearthsideChat.Experience.Enable
#     Description: Master on/off switch. Off means nothing is recorded and
#                  no such background gets added to any prompt.
#     Default:     1
HearthsideChat.Experience.Enable = 1

# HearthsideChat.Experience.MaxEntries
#     Description: Most recent entries included in one prompt, newest
#                  first. A bot may remember more than this internally; the
#                  extra is just kept in reserve for when newer entries
#                  have aged out (see WindowSeconds below).
#     Default:     4
HearthsideChat.Experience.MaxEntries = 4

# HearthsideChat.Experience.MaxChars
#     Description: Character limit for this block. Whole entries are
#                  dropped if they don't fit, rather than cut off
#                  mid-sentence. This gets added to every AI reply for that
#                  bot, so raise it only if your AI server has latency
#                  headroom to spare.
#     Default:     300
HearthsideChat.Experience.MaxChars = 300

# HearthsideChat.Experience.WindowSeconds
#     Description: How recent something has to be to actually get
#                  mentioned. Older entries are still remembered internally
#                  but stop showing up in prompts, so a bot that's been
#                  idle for an hour stops sounding like it just finished a
#                  dungeon. 0 turns off this aging -- everything remembered
#                  gets mentioned regardless of age.
#     Default:     1800 (30 minutes)
HearthsideChat.Experience.WindowSeconds = 1800

# HearthsideChat.Experience.LootMinQuality
#     Description: Minimum item quality worth mentioning as loot (without a
#                  floor, this would fire on every grey item): 0 Poor,
#                  1 Common, 2 Uncommon, 3 Rare, 4 Epic, 5 Legendary.
#                  Adjust for your realm's level range -- a green item is
#                  exciting at level 20 and vendor trash at 80. On a
#                  levelling-heavy realm, 2 is reasonable; at endgame, 4
#                  keeps this to things actually worth mentioning.
#     Default:     3 (Rare)
HearthsideChat.Experience.LootMinQuality = 3

# HearthsideChat.Experience.MoneyMinCopper
#     Description: Smallest single money gain worth mentioning, in copper
#                  (10000 copper = 1 gold). Without a floor, this would
#                  fire on every vendor sale and quest turn-in. Losses are
#                  never mentioned -- a purchase isn't something a bot
#                  would naturally bring up in chat.
#
#                  A gain that doesn't round up to at least 1 gold is
#                  skipped even if it clears this floor, so setting this
#                  below 10000 has no additional effect.
#     Default:     100000 (10 gold)
HearthsideChat.Experience.MoneyMinCopper = 100000

# HearthsideChat.Experience.SkillStep
#     Description: How big a jump in a profession skill has to be before
#                  it's worth mentioning -- and the round number itself is
#                  what gets said, so a bot landing on 301 skill is
#                  recorded as "reached 300 Skinning". Both profession
#                  hooks otherwise fire on every single point gained, so
#                  this is what makes them usable.
#
#                  25 matches how players actually talk about a
#                  profession: nobody announces 287, everyone announces
#                  300. 0 turns off profession mentions entirely.
#     Default:     25
HearthsideChat.Experience.SkillStep = 25


# --------------------------------------------
# IDLE-TIME GENERATOR
# --------------------------------------------
# Writes pre-made chat lines and bot-to-bot scripted scenes ahead of time,
# only during moments when the AI server isn't busy handling a live
# request -- so this never competes with, or slows down, real replies.
# Each run picks one under-stocked topic at a time, generates one
# candidate line, and runs it through the same quality/duplicate checks
# `.hearthside capture` uses before saving it.

# HearthsideChat.Generator.Enable
#     Description: Master on/off switch. Off by default: this is
#                  background work that uses your AI server's idle time
#                  and writes to the database on its own, so it's an
#                  opt-in rather than something that starts automatically.
#     Default:     0 (false)
HearthsideChat.Generator.Enable = 0

# HearthsideChat.Generator.LLM.ApiType / Template / Url / Model / ApiKey / TimeoutSeconds / MaxTokens
#     Description: The background generator's own AI connection settings,
#                  kept separate from the live-reply HearthsideChat.LLM.*
#                  settings above -- even if they currently point at the
#                  same server. Same options as those settings, including
#                  Template (see HearthsideChat.LLM.Template above) --
#                  useful if you want the generator to use a different
#                  model than the one handling live replies.
#     Values:      Template: llama3 | chatml | mistral | gemma
#     Defaults:    llamacpp / llama3 / http://127.0.0.1:8080 / (empty) / (empty) / 30 / 60
HearthsideChat.Generator.LLM.ApiType = llamacpp
HearthsideChat.Generator.LLM.Template = llama3
HearthsideChat.Generator.LLM.Url = http://127.0.0.1:8080
HearthsideChat.Generator.LLM.Model =
HearthsideChat.Generator.LLM.ApiKey =
HearthsideChat.Generator.LLM.TimeoutSeconds = 30
HearthsideChat.Generator.LLM.MaxTokens = 60

# HearthsideChat.Generator.RowsPerBucket
#     Description: How many pre-written lines to keep on hand for each
#                  category/topic combination, tracked separately. The
#                  generator stops filling one once it reaches this number
#                  and moves on to whatever else still needs more.
#     Default:     20
HearthsideChat.Generator.RowsPerBucket = 20

# HearthsideChat.Generator.PollIntervalSeconds
#     Description: How often the generator checks whether the AI server
#                  has gone idle, while it's waiting for its turn.
#     Default:     5
HearthsideChat.Generator.PollIntervalSeconds = 5

# HearthsideChat.Generator.QuotaSatisfiedBackoffSeconds
#     Description: How long the generator waits before checking again once
#                  everything it tracks is fully stocked -- no reason to
#                  poll every few seconds when there's nothing to do.
#     Default:     300
HearthsideChat.Generator.QuotaSatisfiedBackoffSeconds = 300

# HearthsideChat.Generator.PromptVersion
#     Description: A label stamped on every line this generator run
#                  writes, so a bad batch can be found and deleted later
#                  just by this label. Change it when you meaningfully
#                  change how the generator is prompted.
#     Default:     v1
HearthsideChat.Generator.PromptVersion = v3

# HearthsideChat.Generator.ScriptsPerPool
#     Description: How many not-yet-used scripted bot-to-bot conversations
#                  to keep in reserve, for each of three separate pools
#                  (regular /say, Trade, and General) -- so the steady
#                  state is three times this number in total.
#
#                  This is a reserve, not a "how often bots talk" setting:
#                  raising it only banks a bigger buffer against a slow AI
#                  server. Script.Proximity.FireChancePercent above is what
#                  actually controls how often a scene plays. If bots use
#                  up scenes faster than the generator restocks them, they
#                  simply stop having scripted conversations until it
#                  catches up -- that's the intended, safe way for this to
#                  run dry.
#     Default:     50
HearthsideChat.Generator.ScriptsPerPool = 50

# --------------------------------------------
# OBSERVABILITY AND THE CONTROL API
# --------------------------------------------
# An optional web interface for checking module status and, if you choose,
# making changes remotely instead of typing GM commands in-game. Off by
# default. It uses one shared password for the whole server rather than
# individual logins -- this is a single-operator admin tool, not a
# multi-user site.
#
# Read-only requests (status/metrics/inspect) only need that password;
# requests that change anything (promote/demote/retire/pin/unpin/
# evict-run) additionally require HttpControlEnable below. The in-game
# `.hearthside` GM commands do everything this API can, whether or not the
# API is turned on.
#
# RESTART REQUIRED for three of the five settings below. Every other
# HearthsideChat.* setting in this file takes effect on `.reload config`,
# but HttpServerPort, HttpServerBind and HttpServerTimeoutSeconds are only
# read once, at worldserver startup -- changing them and reloading appears
# to succeed but does nothing. HttpServerPrivateKey and HttpControlEnable
# DO take effect on `.reload config`.

# HearthsideChat.HttpServerPort
#     Description: Port to run the web interface on. 0 turns it off
#                  entirely (default) -- the in-game GM commands cover the
#                  same actions without it. Needs a restart to change.
#     Default:     0
HearthsideChat.HttpServerPort = 0

# HearthsideChat.HttpServerBind
#     Description: Which network address to listen on. 127.0.0.1 (the
#                  default) means only this machine can reach it directly
#                  -- put a reverse proxy (nginx, etc.) in front if you
#                  want it reachable from elsewhere, rather than exposing
#                  it directly. Needs a restart to change.
#     Default:     127.0.0.1
HearthsideChat.HttpServerBind = 127.0.0.1

# HearthsideChat.HttpServerPrivateKey
#     Description: Shared password for the web interface. Required
#                  whenever HttpServerPort above is non-zero -- if this is
#                  left blank, the server refuses to start rather than run
#                  unprotected.
#     Default:     (empty)
HearthsideChat.HttpServerPrivateKey =

# HearthsideChat.HttpServerTimeoutSeconds
#     Description: Read/write timeout for the web interface's connections.
#                  Needs a restart to change.
#     Default:     10
HearthsideChat.HttpServerTimeoutSeconds = 10

# HearthsideChat.HttpControlEnable
#     Description: A second switch that must also be on before the web
#                  interface will accept requests that change anything
#                  (promote/demote/retire/pin/unpin/evict-run) -- the
#                  password alone isn't enough for those. Read-only
#                  requests (status/metrics/inspect/review) don't need
#                  this, only the password. Off by default.
#     Default:     0 (false)
HearthsideChat.HttpControlEnable = 0
